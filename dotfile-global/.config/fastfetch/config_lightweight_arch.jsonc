{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 3
    },
    "color": {
      "1": "magenta",
      "2": "magenta"
    }
  },
  "display": {
    "separator": " 󰁔  ",
    "color": {
      "keys": "magenta"
    },
    "size": {
      "ndigits": 0,
      "maxPrefix": "MB"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "magenta"
      }
    },
    "separator",
    {
      "type": "os",
      "key": " OS",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": " Kernel"
    },
    {
      "type": "packages",
      "key": "󰏗 Packages"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "wm",
      "key": " WM"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory"
    },
    {
      "type": "uptime",
      "key": " Uptime"
    },
    {
      "type": "battery",
      "key": " Battery"
    },
    {
      "type": "custom",
      "format": "───────────────────────────────────"
    },
    {
      "type": "colors"
    },
    "break"
  ]
}
