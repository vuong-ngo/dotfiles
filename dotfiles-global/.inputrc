# ============================================================
# GNU Readline Configuration (Universal Vi Keybindings for CLI Tools)
# Enables Vim editing mode inside interactive CLI prompts (agy, etc.)
# ============================================================

set editing-mode vi
set show-mode-in-prompt on

# --- Vi Insert Mode Keybindings ---
set keymap vi-insert
"\e[A": history-search-backward
"\e[B": history-search-forward
Control-l: clear-screen

# --- Vi Command Normal Mode Keybindings ---
set keymap vi-command
"k": history-search-backward
"j": history-search-forward
"h": backward-char
"l": forward-char
"w": next-word
"b": previous-word
"i": insert-comment
