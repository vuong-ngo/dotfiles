/*****----- Configuration for Wallpaper Picker -----*****/
configuration {
    show-icons:                 true;
}

/*****----- Global Properties -----*****/
@import                         "~/.config/rofi/color.rasi"

* {
    /* Mappings based on the shared grayscale palette (color.rasi) */
    border-colour:               var(selected);
    handle-colour:               var(selected);
    background-colour:           var(background);
    foreground-colour:           var(foreground);
    alternate-background:        var(background-alt);
    selected-normal-background:  var(selected);
    selected-normal-foreground:  var(background); /* Chữ màu tối trên nền sáng khi được chọn */
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    west; /* Neo vào bên trái màn hình */
    anchor:                      west;
    fullscreen:                  false;
    width:                       350px; /* Chiều rộng cố định cho Sidebar */
    height:                      98%;   /* Chiều cao gần tràn viền */
    x-offset:                    15px;  /* Cách lề trái 15px để tạo cảm giác trôi nổi */
    y-offset:                    0px;

    enabled:                     true;
    border:                      2px solid;
    border-radius:               0px;
    border-color:                @border-colour;
    background-color:            @background-colour;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     20px;
    padding:                     25px; /* Giảm padding để phù hợp với chiều ngang hẹp */
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar (Modern Search) -----*****/
inputbar {
    enabled:                     true;
    margin:                      0px; /* Xóa margin cũ để thanh search trải đều */
    padding:                     12px 15px;
    background-color:            @alternate-background;
    text-color:                  @foreground-colour;
    border:                      2px solid;
    border-color:                rgba(255, 255, 255, 0.2);
    border-radius:               0px;
    spacing:                     10px;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:                      false;
    str:                         " ";
    font:                        "JetBrains Mono Nerd Font 13";
    background-color:            transparent;
    text-color:                  @selected;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 " Find vibe...";
    placeholder-color:           #ffffff;
}

/*****----- Listview (The Gallery) -----*****/
listview {
    enabled:                     true;
    columns:                     1; /* 1 cột duy nhất */
    lines:                       4; /* Số lượng ảnh hiển thị cùng lúc (có thể tăng/giảm) */
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     10px;
    background-color:            transparent;
    text-color:                  @foreground-colour;
    cursor:                      "default";
}

/*****----- Elements (The Cards) -----*****/
element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     5px;
    margin:                      0px;
    padding:                     5px;
    border-radius:               5px;
    background-color:            transparent;
    text-color:                  @foreground-colour;
    cursor:                      pointer;
}

/* Hover & Selection Animation */
element selected.normal {
    background-color:            @selected-normal-background;
    text-color:                  @selected-normal-foreground;
    border:                      0px;
}

element-icon {
    background-color:            transparent;
    size:                        180px; /* Thu nhỏ ảnh để vừa với cột 350px */
    cursor:                      inherit;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    border-radius:               10px;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    font:                        "JetBrains Mono NF Bold 10";
    horizontal-align:            0.5;
    vertical-align:              0.5;
}
